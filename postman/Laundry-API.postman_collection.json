            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP sesuai\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"customer_token\", d.access_token);",
                  "pm.collectionVariables.set(\"customer_refresh\", d.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
